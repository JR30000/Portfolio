# Copy this file to .env.local for local development and fill in real values there.
# .env.local is gitignored and must never be committed.
# In production (Render), set these in the service's Environment settings —
# never commit real values to the repository.

# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public API key (safe for client exposure; access is enforced via RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional shared secret used to protect the contact form endpoint from abuse
# (e.g. checked against a header, or used as an HMAC key). Leave blank to disable.
CONTACT_FORM_SECRET=
